# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Скопировать на production сервер:
# cp .env.production.example .env
# И заполнить реальными значениями!

# ============================================
# Application Settings
# ============================================
APP_NAME="CLIENTLY"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://cliently.by

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ============================================
# Logging
# ============================================
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ============================================
# Database (MySQL/PostgreSQL for production)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cliently_production
DB_USERNAME=cliently_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ИЛИ PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=cliently_production
# DB_USERNAME=cliently_user
# DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Session (Redis for production!)
# ============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.cliently.by
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_CONNECTION=default

# ============================================
# Cache (Redis for production!)
# ============================================
CACHE_STORE=redis
CACHE_PREFIX=cliently_prod

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# Queue (Redis for production!)
# ============================================
QUEUE_CONNECTION=redis

# Queue Database Settings (если нужен fallback)
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
BROADCASTS_QUEUE_RETRY_AFTER=3600

# ============================================
# Redis Configuration
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ============================================
# Mail Configuration (настроить SMTP!)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cliently.by
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS/S3 (если используете для файлов)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# Telegram Bot (Telegraph)
# ============================================
TELEGRAM_WEBHOOK_DOMAIN=https://cliently.by
TELEGRAPH_WEBHOOK_URL=/api/telegraph/{token}/webhook
TELEGRAPH_WEBHOOK_SECRET=GENERATE_RANDOM_STRING
TELEGRAPH_REPORT_UNKNOWN_COMMANDS=false
TELEGRAPH_WEBHOOK_DEBUG=false
TELEGRAPH_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAPH_HTTP_TIMEOUT=30
TELEGRAPH_HTTP_PROXY=
TELEGRAPH_HTTP_CONNECTION_TIMEOUT=10
TELEGRAPH_PAYMENT_PROVIDER_TOKEN=

# ============================================
# bePaid Payment Gateway (Production!)
# ============================================
BEPAID_TEST_MODE=true
BEPAID_SHOP_ID=365
BEPAID_SECRET_KEY=e836173... (твой ключ)
BEPAID_CURRENCY=BYN

# ============================================
# OAuth Settings
# ============================================
OAUTH_ALLOW_REGISTRATION=true
OAUTH_AUTO_VERIFY_EMAIL=true
OAUTH_REDIRECT_AFTER_LOGIN=/dashboard

# ============================================
# OAuth Providers (настроить для production!)
# ============================================
OAUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

OAUTH_YANDEX_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI="${APP_URL}/oauth/yandex/callback"

OAUTH_VK_ENABLED=false
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI="${APP_URL}/oauth/vk/callback"

OAUTH_MAILRU_ENABLED=false
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI="${APP_URL}/oauth/mailru/callback"

OAUTH_TELEGRAM_ENABLED=false
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI="${APP_URL}/oauth/telegram/callback"

OAUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/oauth/github/callback"

OAUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/oauth/apple/callback"

# ============================================
# Performance & Security
# ============================================
# Opcache (для production)
# php.ini: opcache.enable=1
# php.ini: opcache.memory_consumption=256

# Session Security
SANCTUM_STATEFUL_DOMAINS=cliently.by,www.cliently.by

# CORS (если нужно для API)
# CORS_ALLOWED_ORIGINS=https://cliently.by,https://www.cliently.by

# ============================================
# Monitoring & Debugging (опционально)
# ============================================
# Sentry для отслеживания ошибок
# SENTRY_LARAVEL_DSN=your-sentry-dsn
# SENTRY_TRACES_SAMPLE_RATE=0.2

# New Relic для мониторинга
# NEWRELIC_LICENSE_KEY=
# NEWRELIC_APP_NAME=Cliently Production

# ============================================
# ВАЖНО! ЧТО НУЖНО ИЗМЕНИТЬ:
# ============================================
# 1. APP_KEY - сгенерировать: php artisan key:generate
# 2. DB_PASSWORD - сильный пароль для БД
# 3. REDIS_PASSWORD - если настроен
# 4. MAIL_* - настроить SMTP
# 5. BEPAID_PRODUCTION_* - реальные ключи
# 6. GOOGLE_CLIENT_* - production OAuth ключи
# 7. TELEGRAPH_WEBHOOK_SECRET - случайная строка
# 8. SESSION_DOMAIN - ваш домен
# 9. SANCTUM_STATEFUL_DOMAINS - ваш домен

# ============================================
# ПРОВЕРИТЬ ПЕРЕД ЗАПУСКОМ:
# ============================================
# ✅ APP_DEBUG=false
# ✅ APP_ENV=production
# ✅ CACHE_STORE=redis (НЕ database!)
# ✅ QUEUE_CONNECTION=redis (НЕ database!)
# ✅ SESSION_DRIVER=redis (НЕ database!)
# ✅ DB_CONNECTION=mysql/pgsql (НЕ sqlite!)
# ✅ MAIL_MAILER=smtp (НЕ log!)
# ✅ LOG_LEVEL=warning (НЕ debug!)
# ✅ BEPAID_TEST_MODE=false
# ✅ Все пароли и ключи заполнены
