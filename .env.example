APP_NAME="CLIENTLY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Telegram Webhook Domain (для Telegraph)
TELEGRAM_WEBHOOK_DOMAIN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Queue Database Settings
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
BROADCASTS_QUEUE_RETRY_AFTER=3600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# Telegram Bot (Telegraph)
# ============================================
TELEGRAPH_WEBHOOK_URL=/api/telegraph/{token}/webhook
TELEGRAPH_WEBHOOK_SECRET=
TELEGRAPH_REPORT_UNKNOWN_COMMANDS=true
TELEGRAPH_WEBHOOK_DEBUG=false
TELEGRAPH_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAPH_HTTP_TIMEOUT=30
TELEGRAPH_HTTP_PROXY=
TELEGRAPH_HTTP_CONNECTION_TIMEOUT=10
TELEGRAPH_PAYMENT_PROVIDER_TOKEN=

# ============================================
# bePaid Payment Gateway
# ============================================
BEPAID_TEST_MODE=true
BEPAID_TEST_SHOP_ID=
BEPAID_TEST_SECRET_KEY=
BEPAID_TEST_GATEWAY_BASE=https://demo-gateway.begateway.com
BEPAID_TEST_CHECKOUT_BASE=https://checkout.begateway.com
BEPAID_PRODUCTION_SHOP_ID=
BEPAID_PRODUCTION_SECRET_KEY=
BEPAID_PRODUCTION_GATEWAY_BASE=https://gateway.begateway.com
BEPAID_PRODUCTION_CHECKOUT_BASE=https://checkout.begateway.com
BEPAID_CURRENCY=BYN
BEPAID_WEBHOOK_URL=/webhooks/bepaid
BEPAID_VERIFY_WEBHOOK_SIGNATURE=true
BEPAID_DEFAULT_PAYMENT_METHOD=redirect
BEPAID_SUCCESS_URL=/subscription/payment/success
BEPAID_DECLINE_URL=/subscription/payment/decline
BEPAID_FAIL_URL=/subscription/payment/fail
BEPAID_CANCEL_URL=/subscription/payment/cancel
BEPAID_LOGGING_ENABLED=true
BEPAID_LOGGING_LEVEL=info

# ============================================
# OAuth Settings
# ============================================
OAUTH_ALLOW_REGISTRATION=true
OAUTH_AUTO_VERIFY_EMAIL=true
OAUTH_REDIRECT_AFTER_LOGIN=/dashboard

# ============================================
# OAuth Providers
# ============================================
OAUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

OAUTH_YANDEX_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI="${APP_URL}/oauth/yandex/callback"

OAUTH_VK_ENABLED=false
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI="${APP_URL}/oauth/vk/callback"

OAUTH_MAILRU_ENABLED=false
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI="${APP_URL}/oauth/mailru/callback"

OAUTH_TELEGRAM_ENABLED=false
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI="${APP_URL}/oauth/telegram/callback"

OAUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/oauth/github/callback"

OAUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/oauth/apple/callback"
